{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignalBench",
  "version": "0.1.0",
  "identifier": "dev.signalbench.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SignalBench - SB-CTRL virtual bench",
        "width": 1640,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 760,
        "backgroundColor": "#0d2136"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
