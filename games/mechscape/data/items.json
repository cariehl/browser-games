 "lore_shard_1": {
  "id": "lore_shard_1",
  "display_name": "Data shard: the yard",
  "stackable": false,
  "color": [
   0.3,
   0.75,
   0.85,
   1.0
  ],
  "kind": "lore",
  "description": "A cracked data shard. You can still read it.",
  "lore": "LOG 1. The Scrapyard was a shipbreaking yard for the orbital fleet. Hulls came down on the long wall's rails and the loaders took them apart. When the fleet stopped coming home, the loaders kept working."
 },
 "lore_shard_2": {
  "id": "lore_shard_2",
  "display_name": "Data shard: the pilots",
  "stackable": false,
  "color": [
   0.3,
   0.75,
   0.85,
   1.0
  ],
  "kind": "lore",
  "description": "A cracked data shard. You can still read it.",
  "lore": "LOG 2. Pilots are printed, not born. The manufactory keeps a pattern of every pilot it ever made. If you are reading this, it still keeps yours."
 },
 "lore_shard_3": {
  "id": "lore_shard_3",
  "display_name": "Data shard: Hold",
  "stackable": false,
  "color": [
   0.3,
   0.75,
   0.85,
   1.0
  ],
  "kind": "lore",
  "description": "A cracked data shard. You can still read it.",
  "lore": "LOG 3. Final order from the relay mast: HOLD. Every machine in the yard took it literally. The sentries are still holding."
 },
 "lore_shard_4": {
  "id": "lore_shard_4",
  "display_name": "Data shard: the Undercroft",
  "stackable": false,
  "color": [
   0.3,
   0.75,
