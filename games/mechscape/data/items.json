   1.0
  ],
  "kind": "lore",
  "description": "A cracked data shard. You can still read it.",
  "lore": "LOG 4. Below the yard is the foundry that built the mechs. The warden was set to guard the last blueprint until a crew came back for it."
 },
 "lore_shard_5": {
  "id": "lore_shard_5",
  "display_name": "Data shard: the press",
  "stackable": false,
